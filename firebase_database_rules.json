{
  "rules": {
    "admins": {
      "$key": {
        ".read": "auth != null && $key == auth.token.email.toLowerCase().replace('.', ',')"
      }
    },
    "allowedStudents": {
      ".read": "auth != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true",
      ".write": "auth != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true",
      "$key": {
        ".read": "auth != null && $key == auth.token.email.toLowerCase().replace('.', ',')",
        ".validate": "newData.hasChildren(['email'])",
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 254"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "addedAt": {
          ".validate": "newData.isNumber()"
        },
        "uid": {
          ".write": "auth != null && $key == auth.token.email.toLowerCase().replace('.', ',') && newData.val() == auth.uid",
          ".validate": "newData.isString()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "students": {
      ".read": "auth != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true",
      ".write": "auth != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true",
      ".indexOn": [
        "email"
      ],
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid && auth != null && auth.token.email_verified == true && root.child('allowedStudents').child(auth.token.email.toLowerCase().replace('.', ',')).exists()"
      }
    },
    "learningData": {
      ".read": "((auth != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true) || (auth != null && auth.token.email_verified == true && root.child('allowedStudents').child(auth.token.email.toLowerCase().replace('.', ',')).exists()))",
      ".write": "auth != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true"
    },
    "rooms": {
      ".read": "((auth != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true) || (auth != null && auth.token.email_verified == true && root.child('allowedStudents').child(auth.token.email.toLowerCase().replace('.', ',')).exists()))",
      ".indexOn": [
        "createdAt"
      ],
      "$code": {
        ".write": "((auth != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true) || (auth != null && auth.token.email_verified == true && root.child('allowedStudents').child(auth.token.email.toLowerCase().replace('.', ',')).exists())) && (!data.exists() || data.child('hostUid').val() == auth.uid || data.child('guestUid').val() == auth.uid || (data.child('status').val() == 'waiting' && !data.child('guestUid').exists() && newData.child('guestUid').val() == auth.uid) || (data.child('status').val() == 'waiting' && data.child('createdAt').val() < now - 600000) || !data.child('createdAt').exists() || data.child('createdAt').val() < now - 86400000)",
        ".validate": "newData.hasChildren(['host', 'hostUid', 'status', 'createdAt'])",
        "host": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "guest": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "hostUid": {
          ".validate": "newData.isString() && (newData.val() == auth.uid || newData.val() == data.val())"
        },
        "guestUid": {
          ".validate": "newData.isString() && (newData.val() == auth.uid || newData.val() == data.val())"
        },
        "status": {
          ".validate": "newData.val() === 'waiting' || newData.val() === 'playing'"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "presence": {
          "$role": {
            ".validate": "($role === 'host' || $role === 'guest') && newData.hasChildren(['online', 'lastSeen'])",
            "online": {
              ".validate": "newData.isBoolean()"
            },
            "lastSeen": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "end": {
          ".validate": "newData.hasChildren(['reason', 'loser'])",
          "reason": {
            ".validate": "newData.val() === 'forfeit'"
          },
          "loser": {
            ".validate": "newData.val() === 'host' || newData.val() === 'guest'"
          },
          "$other": {
            ".validate": false
          }
        },
        "match": {
          "$n": {
            "messages": {
              "$msg": {
                ".validate": "newData.hasChildren(['type', 'from', 'timestamp'])",
                "type": {
                  ".validate": "newData.isString() && newData.val().matches(/^(forcedSwitch|party|loaded|rematch|leave|commit|reveal|snapshot)$/)"
                },
                "from": {
                  ".validate": "newData.val() === 'host' || newData.val() === 'guest'"
                },
                "timestamp": {
                  ".validate": "newData.isNumber()"
                },
                "data": {
                  ".validate": true
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "sid": {
          "$role": {
            ".validate": "($role === 'host' || $role === 'guest') && newData.isString() && newData.val().length <= 64"
          }
        },
        "rejoin": {
          "$role": {
            ".validate": "($role === 'host' || $role === 'guest') && newData.hasChildren(['sid', 'at'])",
            "sid": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "resync": {
          "$role": {
            ".validate": "($role === 'host' || $role === 'guest') && newData.hasChildren(['sid', 'n', 'at'])",
            "sid": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "n": {
              ".validate": "newData.isNumber()"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
